# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Security
SECRET_KEY=generate-a-strong-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Seed Credentials (used on initial initialization)
ADMIN_DEFAULT_EMAIL=admin@jhrst.com
ADMIN_DEFAULT_PASSWORD=JhrstAdmin2026#Secure

# Database Configuration
# Default SQLite for local development: sqlite:///./jhrst.db
# PostgreSQL for production: postgresql://postgres:password@localhost:5432/jhrst_db
DATABASE_URL=sqlite:///./jhrst.db

# CORS Configuration (comma-separated or list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://jhrst.vercel.app","https://www.jhrsttech.com"]

# Email / SMTP Configuration (Optional - logs locally if disabled)
SMTP_ENABLED=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jhrst9966@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=notifications@jhrsttech.com
INQUIRY_RECEIVER_EMAIL=jhrst9966@gmail.com

